# ── Required ──
# JSON-RPC endpoint for the target network (Alchemy/Infura/etc.)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Keeper signer private key (32-byte hex, with or without 0x).
# Needed for sending transactions. Omit (or set DRY_RUN=true) for read-only mode.
# NEVER commit a real key. Use the platform's secret manager in production.
PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY

# ── Network / contracts (defaults = live Sepolia deployment) ──
CHAIN_ID=11155111
VAULT_ADDRESS=0x88fb46a354e4771f987c786bcacf026f0792030c
STRATEGY_ADDRESS=0x635161055158b304740958811bc0d5d9999cdb57
USDC_ADDRESS=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8

# ── Behavior ──
# Cron expression for the monitoring loop (default: every 5 minutes)
CRON_SCHEDULE=*/5 * * * *
# Push vault idle USDC to the strategy once idle reaches this many USDC
IDLE_THRESHOLD_USDC=100
# Keep this much idle USDC in the vault as a withdrawal buffer
IDLE_RESERVE_USDC=0
# Don't supply to Aave unless at least this much can be deployed
MIN_SUPPLY_USDC=1
# Simulate only — log decisions, send no transactions
DRY_RUN=false

# ── History ──
HISTORY_FILE=data/history.json
HISTORY_MAX_RECORDS=5000

# ── E2E test only ──
E2E_AMOUNT_USDC=10
E2E_WAIT_SECONDS=0
